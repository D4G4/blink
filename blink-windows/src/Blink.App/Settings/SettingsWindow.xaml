<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Blink.App.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Blink Preferences">

    <NavigationView x:Name="RootNav" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                    SelectionChanged="NavigationView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="General" Tag="general" IsSelected="True">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Theme" Tag="theme">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Edit"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Flow" Tag="flow">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE945;"/></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="About" Tag="about">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Help"/></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <ScrollViewer Padding="24">
            <Grid>
                <!-- General Tab -->
                <StackPanel x:Name="GeneralPanel" Spacing="16" MaxWidth="500" Visibility="Visible">
                    <TextBlock Text="TIMER" FontSize="12" FontWeight="SemiBold" Opacity="0.5"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Base interval" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Slider x:Name="BaseIntervalSlider" Width="160" Minimum="10" Maximum="45" StepFrequency="5"
                                    TickFrequency="5" TickPlacement="Outside"
                                    ValueChanged="BaseIntervalSlider_ValueChanged"/>
                            <TextBlock x:Name="BaseIntervalLabel" VerticalAlignment="Center" Width="50"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="TRAY" FontSize="12" FontWeight="SemiBold" Opacity="0.5" Margin="0,8,0,0"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Show countdown timer" VerticalAlignment="Center"/>
                        <ToggleSwitch x:Name="ShowTimerToggle" Grid.Column="1" Toggled="ShowTimerToggle_Toggled"/>
                    </Grid>

                    <TextBlock Text="BREAK SCREEN" FontSize="12" FontWeight="SemiBold" Opacity="0.5" Margin="0,8,0,0"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Use dark overlay"/>
                            <TextBlock Text="Dims screen during breaks" FontSize="12" Opacity="0.5"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="DarkOverlayToggle" Grid.Column="1" Toggled="DarkOverlayToggle_Toggled"/>
                    </Grid>

                    <TextBlock Text="SYSTEM" FontSize="12" FontWeight="SemiBold" Opacity="0.5" Margin="0,8,0,0"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Launch at login" VerticalAlignment="Center"/>
                        <ToggleSwitch x:Name="LaunchAtLoginToggle" Grid.Column="1" Toggled="LaunchAtLoginToggle_Toggled"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Debug notifications"/>
                            <TextBlock Text="Show toasts for state changes and timer resets" FontSize="12" Opacity="0.5"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="DebugToggle" Grid.Column="1" Toggled="DebugToggle_Toggled"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="UpdateButton" Content="Check for Updates" Click="UpdateButton_Click"/>
                            <ProgressRing x:Name="UpdateProgress" IsActive="False" Width="20" Height="20" Visibility="Collapsed"/>
                            <TextBlock x:Name="UpdateStatusText" VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
                            <HyperlinkButton x:Name="DownloadUpdateButton" Content="Download" Click="DownloadUpdate_Click" Visibility="Collapsed" Padding="0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <HyperlinkButton Content="Restart Onboarding" Click="RestartOnboarding_Click"/>
                </StackPanel>

                <!-- Theme Tab -->
                <StackPanel x:Name="ThemePanel" Spacing="16" MaxWidth="500" Visibility="Collapsed">
                    <TextBlock Text="Choose your theme" FontSize="16" FontWeight="SemiBold"/>
                    <ItemsRepeater x:Name="ThemeGrid">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="120" MinItemHeight="80" MinColumnSpacing="12" MinRowSpacing="12"/>
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Flow Tab (matches macOS FlowSensitivityView .settings style) -->
                <StackPanel x:Name="FlowPanel" Spacing="20" MaxWidth="500" Visibility="Collapsed">
                    <TextBlock Text="FLOW DETECTION" FontSize="12" FontWeight="SemiBold" Opacity="0.5"/>

                    <!-- Three equal-width preset buttons -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="PresetEyeHealthBtn" Click="OnFlowPresetSelected"
                                Tag="eyeHealth" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Padding="0,12" CornerRadius="12"
                                BorderThickness="1.5">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <FontIcon x:Name="FlowIconEyeHealth" Glyph="&#xEB51;" FontSize="22"/>
                                <TextBlock x:Name="FlowNameEyeHealth" Text="Eye health"
                                           FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" x:Name="PresetBalancedBtn" Click="OnFlowPresetSelected"
                                Tag="balanced" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Padding="0,12" CornerRadius="12"
                                BorderThickness="1.5">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <FontIcon x:Name="FlowIconBalanced" Glyph="&#xE94E;" FontSize="22"/>
                                <TextBlock x:Name="FlowNameBalanced" Text="Balanced"
                                           FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" x:Name="PresetDeepWorkBtn" Click="OnFlowPresetSelected"
                                Tag="deepWork" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Padding="0,12" CornerRadius="12"
                                BorderThickness="1.5">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <FontIcon x:Name="FlowIconDeepWork" Glyph="&#xE811;" FontSize="22"/>
                                <TextBlock x:Name="FlowNameDeepWork" Text="Deep work"
                                           FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Description -->
                    <TextBlock x:Name="FlowSensitivityDescription" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>

                    <!-- "How this affects your breaks" full-width button -->
                    <Button x:Name="FlowLearnMoreButton" Click="FlowLearnMore_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="0,8" CornerRadius="8" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <FontIcon x:Name="FlowLearnMoreIcon" Glyph="&#xE7B3;" FontSize="12"/>
                            <TextBlock x:Name="FlowLearnMoreText" Text="How this affects your breaks"
                                       FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>

                    <!-- Action links: Fine-tune (left) / Research (right) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <HyperlinkButton Grid.Column="0" x:Name="FineTuneButton" Content="Fine-tune"
                                         Click="FineTuneToggle_Click" Padding="0" FontSize="11"/>
                        <HyperlinkButton Grid.Column="2" Content="Research"
                                         Click="FlowLearnMore_Click" Padding="0" FontSize="11"/>
                    </Grid>

                    <!-- Fine-tune slider (collapsed by default) -->
                    <StackPanel x:Name="FineTunePanel" Spacing="4" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Slider x:Name="FlowSensitivitySlider" Width="200" Minimum="25" Maximum="90" StepFrequency="5"
                                    ValueChanged="FlowSensitivitySlider_ValueChanged"/>
                            <TextBlock x:Name="FlowSensitivityLabel" VerticalAlignment="Center" Width="40"
                                       FontFamily="Consolas" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- About Tab -->
                <StackPanel x:Name="AboutPanel" Spacing="8" MaxWidth="500" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Blink" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Smart 20-20-20 Break Reminder" HorizontalAlignment="Center" Opacity="0.7"/>
                    <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Opacity="0.5" Margin="0,8,0,16"/>
                    <Button x:Name="OpenLogsButton" Click="OnOpenLogs"
                            HorizontalAlignment="Center" Padding="14,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14"/>
                            <TextBlock Text="Open Logs Folder"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Share these files when reporting an issue"
                               FontSize="11" Opacity="0.5" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </NavigationView>
</Window>
