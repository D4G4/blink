<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Blink.App.Overlay.DebugToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Padding="12,8" CornerRadius="8">
        <Grid.Background>
            <SolidColorBrush Color="#FFCC6600"/>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Bug icon -->
        <FontIcon Grid.Column="0" Glyph="&#xE825;" FontSize="16"
                  Foreground="White" VerticalAlignment="Center"/>

        <!-- Debug message -->
        <TextBlock Grid.Column="1" x:Name="MessageText"
                   FontSize="12" FontFamily="Consolas"
                   Foreground="White" VerticalAlignment="Center"
                   Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
</Window>
