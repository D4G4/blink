<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Blink.App.Overlay.ToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Padding="16,12" CornerRadius="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Eye icon -->
        <FontIcon Grid.Column="0" Glyph="&#xE7B3;" FontSize="24"
                  x:Name="IconElement" VerticalAlignment="Center"/>

        <!-- Break text with countdown -->
        <TextBlock Grid.Column="1" x:Name="MessageText"
                   Text="Break in 3s" FontSize="16" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="12,0,0,0"/>

        <!-- Countdown ring -->
        <ProgressRing Grid.Column="2" x:Name="CountdownRing"
                      IsActive="True" Width="28" Height="28"
                      VerticalAlignment="Center" Margin="8,0,0,0"/>
    </Grid>
</Window>
