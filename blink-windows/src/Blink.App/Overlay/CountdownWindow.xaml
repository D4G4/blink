<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Blink.App.Overlay.CountdownWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" KeyDown="OnKeyDown">
        <Grid.Background>
            <LinearGradientBrush x:Name="BackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop x:Name="GradientTop" Offset="0"/>
                <GradientStop x:Name="GradientBottom" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Centered content -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <TextBlock x:Name="TitleText"
                       Text="Break starting in" FontSize="24"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="CountdownText"
                       Text="3" FontSize="96" FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="HintText"
                       Text="esc to skip" FontSize="14" Opacity="0.5"
                       HorizontalAlignment="Center" Margin="0,16,0,0"/>
        </StackPanel>
    </Grid>
</Window>
