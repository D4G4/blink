<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Blink.App.TrayIcon.MenuBarPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Blink">

    <Grid x:Name="RootGrid" Padding="0">
        <StackPanel Spacing="0">

            <!-- Header -->
            <Grid Padding="16,14,16,12" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" x:Name="IconBackground">
                    <Image x:Name="HeaderIcon" Width="34" Height="34" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Blink" FontSize="14" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Ellipse x:Name="FlowStateDot" Width="6" Height="6"/>
                        <TextBlock x:Name="FlowStateBadge" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Update banner -->
            <Border x:Name="UpdateBanner" Margin="12,0,12,4" Padding="10" CornerRadius="10" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="14" x:Name="UpdateBannerIcon"/>
                        <TextBlock x:Name="UpdateBannerText" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="UpdateDownloadButton" Click="OnDownloadUpdate"
                            HorizontalAlignment="Stretch"
                            Padding="10,4"
                            CornerRadius="999"
                            FontSize="11" FontWeight="SemiBold"
                            Foreground="White">
                        <TextBlock Text="Download"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Timer card -->
            <Border Margin="12,4,12,0" Padding="14" CornerRadius="12" x:Name="TimerCard">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="CountdownText" FontSize="40" FontWeight="Light"
                               FontFamily="Consolas" HorizontalAlignment="Center"/>
                    <Grid Height="6">
                        <Rectangle x:Name="ProgressTrack" RadiusX="3" RadiusY="3"/>
                        <Rectangle x:Name="ProgressFill" RadiusX="3" RadiusY="3"
                                   HorizontalAlignment="Left"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StateLabel" Grid.Column="0" FontSize="11" Opacity="0.6"/>
                        <TextBlock x:Name="DurationLabel" Grid.Column="1" FontSize="11" Opacity="0.45"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Stats -->
            <StackPanel Orientation="Horizontal" Spacing="6" Padding="16,12,16,10">
                <FontIcon Glyph="&#xE7B3;" FontSize="11" x:Name="StatsIcon"/>
                <TextBlock x:Name="StatsText" FontSize="12" Opacity="0.7"/>
            </StackPanel>

            <Rectangle Height="1" Margin="12,0" Opacity="0.15" Fill="Gray"/>

            <!-- Take Break Now button -->
            <Button x:Name="TakeBreakButton" Click="OnTakeBreakNow"
                    Margin="12,12,12,4"
                    HorizontalAlignment="Stretch"
                    Height="32"
                    CornerRadius="8"
                    Foreground="White">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE7B3;" FontSize="12"/>
                    <TextBlock Text="Take Break Now" FontSize="12" FontWeight="Medium"/>
                </StackPanel>
            </Button>

            <!-- Bottom buttons -->
            <Grid Padding="16,10,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="AboutButton" Click="OnAbout"
                        Background="Transparent" BorderThickness="0" Padding="6,4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE9CE;" FontSize="11" Opacity="0.7"/>
                        <TextBlock Text="About" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" x:Name="PreferencesButton" Click="OnPreferences"
                        Background="Transparent" BorderThickness="0" Padding="6,4" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE713;" FontSize="11" Opacity="0.7"/>
                        <TextBlock Text="Preferences" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" x:Name="QuitButton" Click="OnQuit"
                        Background="Transparent" BorderThickness="0" Padding="6,4">
                    <TextBlock Text="Quit" FontSize="12" Opacity="0.5"/>
                </Button>
            </Grid>

        </StackPanel>
    </Grid>
</Window>
