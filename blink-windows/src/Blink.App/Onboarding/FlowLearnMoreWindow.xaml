<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Blink.App.Onboarding.FlowLearnMoreWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Flow Detection">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Sticky header: title + slider -->
        <StackPanel Grid.Row="0" x:Name="HeaderPanel" Spacing="12" Padding="24,20,24,16">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <FontIcon x:Name="HeaderIcon" Glyph="&#xE945;" FontSize="24"/>
                <TextBlock Text="How Flow Detection Works"
                           FontSize="18" FontWeight="Bold"/>
            </StackPanel>

            <StackPanel Spacing="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Low" FontSize="11" Opacity="0.6"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider Grid.Column="1" x:Name="SensitivitySlider"
                            ValueChanged="SensitivitySlider_ValueChanged"/>
                    <TextBlock Grid.Column="2" Text="High" FontSize="11" Opacity="0.6"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock x:Name="SensitivityLabel" FontSize="12" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanel" Spacing="16" Padding="24,8,24,24"/>
        </ScrollViewer>

        <!-- Got it button -->
        <Border Grid.Row="2" Padding="16">
            <Button x:Name="GotItButton" Content="Got it" Click="OnGotIt"
                    HorizontalAlignment="Stretch" Height="36"
                    FontSize="14" FontWeight="SemiBold"
                    Foreground="White" CornerRadius="8"/>
        </Border>
    </Grid>
</Window>
