<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Blink.App.Onboarding.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Welcome to Blink">

    <Grid x:Name="RootGrid" Padding="40">

        <!-- Page 1: Theme Selection -->
        <Grid x:Name="ThemePage">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Welcome text -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="8">
                <TextBlock x:Name="WelcomeTitle" Text="Welcome to Blink"
                           FontSize="36" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="WelcomeSubtitle" Text="Smart breaks for your eyes"
                           FontSize="16" Opacity="0.7"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Theme icon -->
            <Image Grid.Row="1" x:Name="ThemeIcon"
                   Width="200" Height="200"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Theme name -->
            <TextBlock Grid.Row="2" x:Name="ThemeName"
                       FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,16,0,0"/>

            <!-- Navigation -->
            <StackPanel Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Center" Spacing="24" Margin="0,24,0,0">
                <Button x:Name="PrevButton" Content="&#x25C0;" Click="OnPrevious"
                        FontSize="24" Width="48" Height="48"/>
                <Button x:Name="NextButton" Content="&#x25B6;" Click="OnNext"
                        FontSize="24" Width="48" Height="48"/>
            </StackPanel>

            <!-- Continue -->
            <StackPanel Grid.Row="4" HorizontalAlignment="Center" Spacing="12" Margin="0,32,0,0">
                <Button Content="Continue" Click="OnContinueToFlow"
                        FontSize="16" FontWeight="SemiBold"
                        Width="200" Height="48"
                        HorizontalAlignment="Center"/>
                <HyperlinkButton Content="Why do I exist?" Click="OnWhyExist"
                                 HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Page 2: Flow Sensitivity (matches macOS FlowSensitivityPage layout) -->
        <Grid x:Name="FlowPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0: back button -->
                <RowDefinition Height="Auto"/>  <!-- 1: icon -->
                <RowDefinition Height="Auto"/>  <!-- 2: title -->
                <RowDefinition Height="*"/>     <!-- 3: top spacer (centers cards) -->
                <RowDefinition Height="Auto"/>  <!-- 4: cards -->
                <RowDefinition Height="Auto"/>  <!-- 5: description -->
                <RowDefinition Height="*"/>     <!-- 6: bottom spacer (centers cards) -->
                <RowDefinition Height="Auto"/>  <!-- 7: buttons -->
            </Grid.RowDefinitions>

            <!-- Back button -->
            <Button Grid.Row="0" Click="OnBackToThemes"
                    Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Padding="8,6" Margin="-20,-20,0,0">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE76B;" FontSize="12" Opacity="0.7"/>
                    <TextBlock x:Name="BackLabel" Text="Themes" FontSize="13" FontWeight="Medium" Opacity="0.7"/>
                </StackPanel>
            </Button>

            <!-- Head/brain icon -->
            <FontIcon Grid.Row="1" x:Name="FlowIcon" Glyph="&#xE77B;"
                      FontSize="56"
                      HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Title only (no subtitle — matches macOS) -->
            <TextBlock Grid.Row="2" x:Name="FlowTitle" Text="Flow Detection"
                       FontSize="32" FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <!-- Top spacer -->
            <Grid Grid.Row="3"/>

            <!-- Preset cards -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="14"
                        HorizontalAlignment="Center">

                <Button x:Name="PresetEyeHealth" Click="OnPresetSelected"
                        Tag="eyeHealth" Background="Transparent" BorderThickness="0"
                        Padding="0" CornerRadius="14">
                    <Border x:Name="CardEyeHealth" CornerRadius="14" Padding="10,20"
                            Width="160" MinHeight="140">
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                            <FontIcon x:Name="IconEyeHealth" Glyph="&#xEB51;" FontSize="32"/>
                            <TextBlock x:Name="NameEyeHealth" Text="Eye health"
                                       FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DescEyeHealth" Text="Regular breaks. Only intense work extends."
                                       FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="140"/>
                        </StackPanel>
                    </Border>
                </Button>

                <Button x:Name="PresetBalanced" Click="OnPresetSelected"
                        Tag="balanced" Background="Transparent" BorderThickness="0"
                        Padding="0" CornerRadius="14">
                    <Border x:Name="CardBalanced" CornerRadius="14" Padding="10,20"
                            Width="160" MinHeight="140">
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                            <FontIcon x:Name="IconBalanced" Glyph="&#xE94E;" FontSize="32"/>
                            <TextBlock x:Name="NameBalanced" Text="Balanced"
                                       FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DescBalanced" Text="Smart timing. Extends for focused work."
                                       FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="140"/>
                        </StackPanel>
                    </Border>
                </Button>

                <Button x:Name="PresetDeepWork" Click="OnPresetSelected"
                        Tag="deepWork" Background="Transparent" BorderThickness="0"
                        Padding="0" CornerRadius="14">
                    <Border x:Name="CardDeepWork" CornerRadius="14" Padding="10,20"
                            Width="160" MinHeight="140">
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                            <FontIcon x:Name="IconDeepWork" Glyph="&#xE811;" FontSize="32"/>
                            <TextBlock x:Name="NameDeepWork" Text="Deep work"
                                       FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DescDeepWork" Text="Fewer interruptions. Gentle reminders."
                                       FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="140"/>
                        </StackPanel>
                    </Border>
                </Button>
            </StackPanel>

            <!-- Description for selected preset -->
            <TextBlock Grid.Row="5" x:Name="FlowDescLabel"
                       FontSize="15" FontWeight="Medium"
                       TextAlignment="Center" TextWrapping="Wrap"
                       HorizontalAlignment="Center" MaxWidth="600"
                       VerticalAlignment="Top" Margin="0,28,0,0"/>

            <!-- Bottom spacer -->
            <Grid Grid.Row="6"/>

            <!-- Buttons (30px spacing matching macOS) -->
            <StackPanel Grid.Row="7" HorizontalAlignment="Center" Spacing="30" Margin="0,0,0,20">
                <Button x:Name="ExploreButton" Click="OnExploreHowItWorks"
                        BorderThickness="0"
                        HorizontalAlignment="Center" Padding="20,10"
                        CornerRadius="20">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9E9;" FontSize="14"/>
                        <TextBlock Text="Explore how it works" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <Button x:Name="GetStartedButton" Click="OnGetStarted"
                        FontSize="17" FontWeight="SemiBold"
                        Width="200" Height="48"
                        CornerRadius="24"
                        HorizontalAlignment="Center">
                    <TextBlock Text="Get Started"/>
                </Button>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
